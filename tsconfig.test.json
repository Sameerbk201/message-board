{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    "types": ["node", "vitest/globals"],

    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.api.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/scripts/**"]
}
