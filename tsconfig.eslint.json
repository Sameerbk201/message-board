{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "noEmit": true,

    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",

    "scripts/**/*.ts",
    "scripts/**/*.mjs",

    "eslint.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.api.config.ts",
    "vitest.unit.config.ts",
    "tsup.config.ts"
  ],
  "exclude": ["node_modules", "dist", "playground-*.mongodb.js", "**/playground-*.mongodb.js"]
}
