{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,

    "types": ["node"],

    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo"
  },
  "include": [
    "scripts/**/*.ts",
    "src/cli/**/*.ts",
    "eslint.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.api.config.ts",
    "tsup.config.ts",
    "scripts/encrypt.ts",
    "src/scripts/infra/trim.alkukysely.questions.ts",
    "src/scripts/infra/reencrypt.user.email.ts",
    "src/scripts/infra/list.permissions.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
