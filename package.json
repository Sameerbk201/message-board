{
  "name": "message-board",
  "version": "3.0.12",
  "description": "Message Board backend",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('.cache/.tsconfig.build.tsbuildinfo', { force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:tsc": "npm run clean && tsc -p tsconfig.build.json",
    "build:bundle": "npm run build:tsc && esbuild dist/server.js --bundle --platform=node --format=cjs --target=node22 --define:import.meta.url=__bundleUrl --banner:js=\"const __bundleUrl = require('node:url').pathToFileURL(__filename).href;\" --outfile=dist/server.bundle.cjs",
    "build:sea": "npm run build:bundle && node scripts/build.sea.mjs",
    "build:sea:mac": "npm run build:bundle && node scripts/build.sea.mjs --mac",
    "build:es": "npm run clean && npm run typecheck && node --import tsx scripts/build.es.ts",
    "dev": "tsx watch src/server.ts",
    "dev:dev": "cross-env NODE_ENV=development npx tsx watch src/server.ts",
    "dev:local": "cross-env NODE_ENV=development npx tsx watch src/server.ts",
    "dev:cloud": "cross-env NODE_ENV=staging npx tsx watch src/server.ts",
    "script": "tsx",
    "licenses": "node --import tsx scripts/list.dependency.licenses.ts",
    "dev:debug": "cross-env NODE_ENV=development npx tsx watch --inspect-brk src/server.ts",
    "debug:file": "node --inspect-brk=9229 --import tsx",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.{ts,js}\" --ignore-pattern \"src/scripts/**\" --ignore-pattern \"src/**/*.test.ts\" --ignore-pattern \"src/**/*.spec.ts\" --ignore-pattern \"src/**/tests/**\" --ignore-pattern \"src/**/smoke-tests/**\"",
    "lint:fix": "npm run lint -- --fix",
    "lint:tests": "eslint \"src/**/tests/**/*.{ts,js}\" \"src/**/smoke-tests/**/*.{ts,js}\" --no-error-on-unmatched-pattern",
    "lint:scripts": "eslint \"scripts/**/*.{ts,js,mjs,cjs}\" \"src/scripts/**/*.{ts,js}\" \"*.config.{ts,js,mjs,cjs}\" --no-error-on-unmatched-pattern",
    "lint:all": "npm run lint && npm run lint:tests && npm run lint:scripts",
    "lint:file": "eslint",
    "lint:markdown": "markdownlint-cli2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:vitest:integration": "vitest run --config vitest.integration.config.ts",
    "test:vitest:cluster:integration": "cross-env INTEGRATION_ENV_FILE=.env vitest run --config vitest.integration.config.ts",
    "test:vitest:cloud:integration": "cross-env INTEGRATION_ENV_FILE=.env vitest run --config vitest.integration.config.ts",
    "test:vitest:unit": "cross-env INTEGRATION_ENV_FILE=.env vitest run --config vitest.unit.config.ts",
    "test:vitest:cloud:unit": "cross-env INTEGRATION_ENV_FILE=.env vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:seed": "tsx src/tests/seeds/integration.seed.ts",
    "cli:seed": "tsx src/cli/seeds/development.seed.ts",
    "test:coverage": "vitest run --coverage",
    "smoke:test": "node --import tsx --test",
    "node:test": "node --import tsx --test",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests && npm run typecheck:scripts",
    "check": "npm run lint && npm run typecheck",
    "release:message-board": "node --import tsx scripts/release.new.version.ts",
    "dev:infra:setup": "tsx scripts/run.setup.test.infra.ts",
    "test:infra:setup": "tsx scripts/run.setup.test.infra.ts",
    "test:infra:reset": "tsx scripts/run.setup.test.infra.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "message-board",
    "backend",
    "v3"
  ],
  "author": "Message Board",
  "license": "MIT",
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@scalar/express-api-reference": "^0.10.30",
    "amqplib": "^0.10.9",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bowser": "^2.14.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "emoji-regex": "^10.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "html-entities": "^2.6.0",
    "ipaddr.js": "^1.9.1",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "luxon": "^3.7.2",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.1",
    "nanoid": "5.1.16",
    "open": "^11.0.0",
    "otpauth": "^9.5.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "sanitize-html": "^2.17.0",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.23.0",
    "zod": "^4.1.12"
  },
  "peerDependenciesMeta": {
    "pino-pretty": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/express": "^5.0.6",
    "@types/json5": "^0.0.30",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/morgan": "^1.9.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.10.12",
    "@types/qrcode": "^1.5.6",
    "@types/rate-limit-redis": "^1.7.4",
    "@types/sanitize-html": "^2.16.0",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/eslint-plugin": "^1.6.6",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "markdownlint-cli2": "0.23.3",
    "postject": "1.0.0-alpha.6",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "supertest": "^7.2.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.6"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "@scarf/scarf": false,
    "fsevents": false,
    "unrs-resolver": false
  },
  "overrides": {
    "katex": "0.18.2",
    "smol-toml": "1.9.1"
  }
}
